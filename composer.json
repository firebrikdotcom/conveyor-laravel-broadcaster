{
    "name": "kanata-php/conveyor-laravel-broadcaster",
    "description": "Conveyor Laravel Broadcaster",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Kanata\\LaravelBroadcaster\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kanata\\LaravelBroadcaster\\Tests\\": "tests/",
            "Conveyor\\SubProtocols\\Conveyor\\Persistence\\Interfaces\\": "tests/Fixtures/Conveyor/"
        }
    },
    "authors": [
        {
            "name": "Savio Resende"
        }
    ],
    "require": {
        "php": "^8.3",
        "firebase/php-jwt": "^7.0",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/broadcasting": "^13.0",
        "guzzlehttp/guzzle": "^8.0",
        "illuminate/http": "^13.0",
        "illuminate/auth": "^13.0",
        "psr/http-message": "^2.0",
        "ramsey/uuid": "^4.7",
        "symfony/http-kernel": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpro/grumphp": "^2.26",
        "squizlabs/php_codesniffer": "^4.0.4",
        "phpstan/phpstan": "^2.3.5",
        "friendsofphp/php-cs-fixer": "^3.95.29",
        "larastan/larastan": "^3.14",
        "orchestra/testbench": "^11.3",
        "phpunit/phpunit": "^13.4.6",
        "mockery/mockery": "^1.6.15"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kanata\\LaravelBroadcaster\\ConveyorServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "phpro/grumphp": true
        },
        "sort-packages": true
    },
    "type": "library",
    "suggest": {
        "kanata-php/socket-conveyor": "Optional server-side user association integration; run the WebSocket server separately."
    },
    "scripts": {
        "test": "phpunit --no-coverage",
        "coverage": "phpunit --coverage-text --coverage-clover coverage/clover.xml",
        "analyse": "phpstan analyse --memory-limit=512M",
        "lint": "phpcs --standard=PSR12 src config",
        "check": [
            "@test",
            "@analyse",
            "@lint"
        ]
    },
    "archive": {
        "exclude": [
            "/.*",
            "/tests",
            "/vendor",
            "/coverage",
            "/composer.lock",
            "/phpunit.xml",
            "/phpstan.neon",
            "/grumphp.yml",
            "/Makefile"
        ]
    }
}
